# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env ขึ้น Git)

# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Database (PostgreSQL) ---
# ตัวอย่างรูปแบบ: postgres://<user>:<password>@<host>:<port>/<database>
# (ไม่ต้องใส่ sslmode ต่อท้าย — โค้ดจะเปิด SSL อัตโนมัติเมื่อ host ไม่ใช่ localhost/db)
DATABASE_URL=postgres://user:password@localhost:5432/srm_db

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h

